  {
    "id": "zha-shu-tiao-2026-001",
    "name": "炸薯条",
    "imageSrc": "https://shiyuji.xyz/img/recipes/zhashutiao.webp",
    "brief": "外酥里嫩，金黄酥脆，撒上椒盐或蘸番茄酱，是大人小孩都爱的经典小食。",
    "categoryIds": ["2", "7", "13", "21"],
    "difficulty": "简单",
    "time": "25分钟",
    "badge": ["新"],
    "serving_count": "2",
    "ingredients": "土豆: 2个\n玉米淀粉: 4汤匙\n食用油（炸制用）: 适量\n盐（可选）: 1/2茶匙",
    "steps": [
      {
        "text": "【切条浸泡】：土豆去皮，切成约5~6毫米厚的均匀长条。切好的土豆条放入清水中浸泡5分钟，洗去表面多余淀粉，捞出沥干水分。"
      },
      {
        "text": "【焯水断生】：锅中加入足量清水，大火烧开后，倒入沥干的土豆条。保持大火煮1分钟，期间轻轻搅动使受热均匀，煮至土豆条呈半透明状（约七成熟），关火捞出，彻底沥干水分。",
        "imageSrc": "https://shiyuji.xyz/img/steps/zhashutiao_step1.webp"
      },
      {
        "text": "【裹粉上浆】：将沥干的土豆条放入大碗中，分次加入玉米淀粉，每次加入后轻轻翻拌，使每根土豆条都均匀裹上一层薄薄的淀粉（少量多次，裹匀即可）。"
      },
      {
        "text": "【初炸定型】：锅中倒入足量食用油，烧至六成热（约160°C，油面微动）。倒入裹好粉的土豆条，转中火炸制约2分钟，炸至表面微黄、外壳定型变硬，用筷子拨动时感觉酥脆，捞出沥油。",
        "imageSrc": "https://shiyuji.xyz/img/steps/zhashutiao_step2.webp"
      },
      {
        "text": "【复炸酥脆】：将锅中油温升至八成热（约200°C，油面微微冒烟），倒入初炸好的薯条，复炸约30~40秒，至表面金黄酥脆、香味四溢，关火捞出沥干油分。"
      },
      {
        "text": "【撒料装盘】：将炸好的薯条放入大碗中，趁热撒上适量盐（或椒盐）调味，颠簸均匀后装盘，可搭配番茄酱享用。",
        "imageSrc": "https://shiyuji.xyz/img/steps/zhashutiao_step3.webp"
      }
    ]
  },