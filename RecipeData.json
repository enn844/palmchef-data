[
  {
    "id": "e305e54d-d7e1-45a7-93e1-38f3812d4d9c",
    "name": "经典蛋炒饭",
    "imageSrc": "https://pub-bc512af47ad145a48c3642e207e4e369.r2.dev/images/recipes/Egg_fried_rice.png",
    "brief": "家常菜 / 快手菜",
    "categoryIds": ["1", "2", "7","11","28"], 
    "difficulty": "简单",
    "time": "15分钟",
    "ingredients": "米饭: 1碗（约200克，最好是隔夜饭）\n鸡蛋: 2个\n葱: 适量（切成葱花）\n火腿或腊肠: 50克（可选，切丁）\n盐: 适量\n酱油: 1/2 茶匙\n食用油: 适量",
    "steps": [
      "将鸡蛋打入碗中，加入少许盐，用筷子充分打散。将胡萝卜和火腿切成小丁，葱切成葱花备用。",
      "锅中倒入适量食用油，烧至五成热。倒入鸡蛋液，快速划散，炒至半熟或八成熟后盛出备用。",
      "锅中留底油，放入火腿丁翻炒约30秒至1分钟，炒出香味。待火腿炒香后，放入葱花，快速翻炒出葱香味。",
      "倒入隔夜米饭，用锅铲或勺子背面将米饭快速捣散、压平，与配料充分混合，确保米饭不结块。",
      "倒入之前炒好的鸡蛋，加入适量盐，然后加入 1/2 茶匙酱油。大火快速翻炒，使米饭、鸡蛋和配料均匀混合，直至米饭颗粒分明、口感干爽。",
      "临出锅前，快速翻炒几下即可关火。盛盘享用。"
    ]
  },
